# Table extractor settings. Copy this file to .env (cp .env.example .env); extract.py reads .env from the folder
# it is started in. A variable set in the environment, or a command line option, wins over .env.
# Keep the key in double quotes (it holds characters a shell would read).

# your copy of the game's CDN files (config/ and bundle/ inside it)
WOOFIA_CDN=cdn

# the client's bundle key (decrypts main_data)
WOOFIA_BUNDLE_KEY="DOCpTX'f;E!GM#|j"
