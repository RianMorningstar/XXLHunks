# Server settings. Copy this file to .env (cp .env.example .env) and change what you need; the
# server reads .env from the folder it is started in. A variable set in the environment wins over .env.
# Keep the keys in double quotes (they hold characters a shell would read).

# address to listen on (an Android emulator reaches the PC as 10.0.2.2)
WOOFIA_ADDR=127.0.0.1:8720

# saved accounts, logins, guilds and logs
WOOFIA_DATA=data

# your copy of the game's CDN files (config/, bundle/, hotupdate/, version/)
WOOFIA_CDN=cdn

# the tables the table extractor writes
WOOFIA_TABLES=tables/json
WOOFIA_RAW_TABLES=tables/raw
WOOFIA_ITEM_NAMES=tables/items.json
# avatars and the sign-in picture for the admin panel (the extractor's art step)
WOOFIA_ART=tables/art

# the client's bundle key (main_data): lets the events page write event dates into the game's tables
WOOFIA_BUNDLE_KEY="DOCpTX'f;E!GM#|j"

# the PlayHorny login kit's key and nonce: the server answers its domain lists with them
WOOFIA_SDK_KEY="0fd2f681d7be7d8f724ff28313f2e437"
WOOFIA_SDK_NONCE="0pqd6eq1BYnh"

# live update address given to clients that come through the proxy
WOOFIA_SSE_URL=http://127.0.0.1:8720/

# lets other machines sign in to the admin panel with this key; 16 characters or more. Empty: this machine only
WOOFIA_ADMIN_KEY=

# a folder of captured replies, for calls the server has no logic for (research only). Empty: off
WOOFIA_REPLAY=

# tests only: lets the admin page move the game clock. Leave unset to keep it off
# WOOFIA_TEST_CLOCK=1
